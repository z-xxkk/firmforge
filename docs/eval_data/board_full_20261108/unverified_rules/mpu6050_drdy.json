  "rules": [
    {
      "id": "R-GPIO-001",
      "kind": "forbidden",
      "scope": [
        "gpio",
        "all"
      ],
      "text": "GPIO2、GPIO8、GPIO9 是 strapping 引脚，复位时决定芯片启动模式，禁止把它们当普通 IO 用于外设信号",
      "cite": {
        "doc": "esp32c3-ds",
        "page": 30,
        "section": "3 Boot Configurations",
        "quote": "Chip boot mode\n– Strapping pins: GPIO2, GPIO8, and GPIO9"
      },
      "tier": "official_manual",
      "status": "approved",
      "check": {
        "type": "pin_forbidden",
        "gpio": [
          2,
          8,
          9
        ]
      },
      "notes": [
        "规则模式 unverified：未核对"
      ]
    },
    {
      "id": "R-GPIO-002",
      "kind": "peripheral",
      "scope": [
        "gpio"
      ],
      "text": "GPIO9 复位时默认弱上拉（位值 1），不要在它上面加外部下拉或驱动低电平，否则会改变启动模式",
      "cite": {
        "doc": "esp32c3-ds",
        "page": 30,
        "section": "Table 3-1. Default Configuration of Strapping Pins",
        "quote": "GPIO9 Weak pull-up 1"
      },
      "tier": "official_manual",
      "status": "approved",
      "check": null,
      "notes": [
        "规则模式 unverified：未核对"
      ]
    },
    {
      "id": "R-GPIO-003",
      "kind": "timing",
      "scope": [
        "gpio",
        "all"
      ],
      "text": "复位后 strapping 引脚被锁存采样、锁存值无法在运行中改变，复位 3 ms 之后这些引脚才可作为普通 IO 使用",
      "cite": {
        "doc": "esp32c3-ds",
        "page": 30,
        "section": "Table 3-2. Description of Timing Parameters for the Strapping Pins",
        "quote": "Hold time is the time reserved for the chip to read the strapping pin values after CHIP_EN is already high and before these pins start operating as regular IO pins."
      },
      "tier": "official_manual",
      "status": "approved",
      "check": null,
      "notes": [
        "规则模式 unverified：未核对"
      ]
    },
    {
