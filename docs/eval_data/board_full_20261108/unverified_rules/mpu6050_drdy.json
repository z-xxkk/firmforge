        "doc": "idf-driver-i2c-master-h",
        "page": null,
        "section": "i2c_master.h",
        "quote": "esp_err_t i2c_new_master_bus(const i2c_master_bus_config_t *bus_config, i2c_master_bus_handle_t *ret_bus_handle);"
      },
      "tier": "official_code",
      "status": "approved",
      "check": {
