      ]
    },
    {
      "id": "R-LEDC-002",
      "kind": "api",
      "scope": [
        "ledc"
      ],
      "text": "改占空比先 ledc_set_duty() 再 ledc_update_duty()，不调用 update 不生效",
      "cite": {
        "doc": "idf-driver-ledc-h",
        "page": null,
        "section": "ledc_set_duty / ledc_update_duty",
        "quote": "ledc_set_duty, ledc_set_duty_with_hpoint and ledc_update_duty are not thread-safe, do not call these functions to"
      },
      "tier": "official_code",
      "status": "approved",
      "check": {
        "type": "api_exists",
        "symbol": "ledc_update_duty",
        "header": "driver/ledc.h"
      },
      "notes": [
        "规则模式 unverified：未核对"
      ]
    },
    {
      "id": "R-LEDC-003",
      "kind": "forbidden",
      "scope": [
        "ledc"
      ],
      "text": "不要在多个任务里并发调用 ledc_set_duty/ledc_set_duty_with_hpoint/ledc_update_duty 控制同一通道（非线程安全）",
      "cite": {
        "doc": "idf-driver-ledc-h",
        "page": null,
        "section": "ledc_set_duty / ledc_update_duty",
        "quote": "are not thread-safe, do not call these functions to"
