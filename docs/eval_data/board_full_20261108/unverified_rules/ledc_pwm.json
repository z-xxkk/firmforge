      "id": "R-LEDC-001",
      "kind": "api",
      "scope": [
        "ledc"
      ],
      "text": "LEDC 初始化用 driver/ledc.h 的 ledc_timer_config() 与 ledc_channel_config()，不要用旧版 ledc_init 之类接口",
      "cite": {
        "doc": "idf-driver-ledc-h",
        "page": null,
        "section": "ledc_channel_config_t / ledc_timer_config_t",
        "quote": "Configuration parameters of LEDC channel for ledc_channel_config function"
      },
      "tier": "official_code",
