# 桌面软件的测试与截图镜像：在判定器镜像上加 PySide6、Qt 运行库和中文字体。
# 用法：docker build -t firmforge-gui -f docker/Dockerfile.gui .
#       docker run --rm -e QT_QPA_PLATFORM=offscreen -v "$PWD":/work -w /work --entrypoint python3 firmforge-gui -m unittest tests/test_gui.py
FROM firmforge

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      libgl1 libegl1 libxkbcommon0 libfontconfig1 libdbus-1-3 libglib2.0-0 \
      fonts-noto-cjk fonts-noto-mono \
 && rm -rf /var/lib/apt/lists/* \
 && pip install --break-system-packages "PySide6==6.9.1"

ENV QT_QPA_PLATFORM=offscreen
